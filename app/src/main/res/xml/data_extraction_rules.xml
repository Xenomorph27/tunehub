<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the library goes in cloud backups and device transfers; downloaded audio doesn't -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="library.json" />
        <exclude domain="file" path="downloads/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="library.json" />
        <exclude domain="file" path="downloads/" />
    </device-transfer>
</data-extraction-rules>
