<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only the library goes in cloud backups and device transfers; downloaded audio is left out -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="library.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="library.json" />
    </device-transfer>
</data-extraction-rules>
